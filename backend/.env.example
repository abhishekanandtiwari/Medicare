# Environment Variables for Medicare-AI
PROJECT_NAME="Medicare-AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./medicare.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/medicare_db"

# JWT Secret & Expiry
SECRET_KEY="replace-with-a-cryptographically-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External AI APIs (Optional - falls back to offline medical inference engine if omitted)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=15
